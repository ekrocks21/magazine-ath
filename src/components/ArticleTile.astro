---
/**
 * One article as an image card: the frame, a tag reading section and
 * issue, and the title.
 *
 * Articles without hero art fall back to the illustration plates —
 * every Spring 2026 piece is in that position, so the frame has to
 * hold either way rather than collapsing.
 */

import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CardIllustration from './CardIllustration.astro';
import { articleRoute } from '../utils/article-route';

interface Props {
  article: CollectionEntry<'articles'>;
  /** Pre-composed "Section · Issue" line. */
  tag: string;
  /** The issue's lead piece — same card, said louder. */
  lead?: boolean;
}

const { article, tag, lead = false } = Astro.props;
const route = articleRoute(article);
const { title, hero_image, hero_image_alt } = article.data;
---

<a class:list={["tile", lead && "tile--lead"]} href={route.href}>
  <span class="tile__frame">
    {
      hero_image ? (
        <Image
          src={hero_image}
          alt={hero_image_alt ?? title}
          class="tile__img"
          widths={lead ? [640, 1280] : [420, 840]}
          sizes={lead ? '(max-width: 860px) 92vw, 46vw' : '(max-width: 860px) 92vw, 30vw'}
        />
      ) : (
        <CardIllustration slug={route.articleSlug} title={title} />
      )
    }
  </span>
  <span class="tile__foot">
    <span class="tile__tag">{tag}</span>
    <span class="tile__title">{title}</span>
  </span>
</a>

<style>
  /* ── Article tiles ────────────────────────────────────────────── */
  .tile {
    display: block;
    width: 100%;
    text-decoration: none;
  }
  .tile__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy);
  }
  .tile__frame :global(img),
  .tile__frame :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out;
  }
  .tile:hover .tile__frame :global(img),
  .tile:focus-visible .tile__frame :global(img) {
    transform: scale(1.04);
  }
  .tile__foot {
    display: block;
    padding-top: 12px;
  }
  .tile__tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust-light);
    margin-bottom: 6px;
  }
  .tile__title {
    display: block;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--on-dark-1);
    transition: color 0.2s ease-out;
  }
  .tile:hover .tile__title {
    color: var(--sand-light);
  }
  .tile:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: 4px;
  }

  /* ── The statement, on blue ───────────────────────────────────── */
  .statement {
    background: var(--navy);
    padding: 88px 0 96px;
  }
  .statement__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .statement__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
    margin: 0 0 16px;
  }
  .statement__title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--on-dark-1);
    margin: 0 0 22px;
  }
  .statement__title em {
    font-weight: 400;
    font-style: italic;
  }
  .statement__dek {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-dark-3);
    max-width: 560px;
    margin: 0;
  }

  /* An animated zoom is exactly what this setting asks not to see. */
  @media (prefers-reduced-motion: reduce) {
    .tile__frame :global(img) { transition: none; }
    .tile:hover .tile__frame :global(img) { transform: none; }
  }

  /* The lead: the same card, given more room and more voice. */
  .tile--lead .tile__frame {
    aspect-ratio: 3 / 2;
  }
  .tile--lead .tile__tag {
    font-size: 10px;
  }
  .tile--lead .tile__title {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1.12;
  }

  @media (max-width: 860px) {
    .tile--lead .tile__frame { aspect-ratio: 16 / 9; }
  }
</style>
