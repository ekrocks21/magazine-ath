---
/**
 * Gallery — 3-column responsive grid of pipeline-optimized article frames.
 *
 * Rendered by the article template when frontmatter has a `gallery: [...]`
 * array. Each item goes through the Astro image pipeline. A small inline
 * script wires up a no-dependency lightbox that opens the full-resolution
 * frame on click.
 */

import { Image } from 'astro:assets';

type ImgMeta = {
  src: string;
  width: number;
  height: number;
  format?: string;
};

export interface GalleryItem {
  src: ImgMeta;
  alt: string;
  caption?: string;
  credit?: string;
}

interface Props {
  items: GalleryItem[];
  title?: string;
}

const { items, title } = Astro.props;
---

{items.length > 0 && (
  <figure class="article-gallery">
    {title && (
      <figcaption class="article-gallery-title">
        <span class="article-gallery-rule" aria-hidden="true"></span>
        <span>{title}</span>
        <span class="article-gallery-rule" aria-hidden="true"></span>
      </figcaption>
    )}
    <div class="article-gallery-grid" data-gallery-grid>
      {items.map((item) => (
        <a
          class="article-gallery-cell"
          href={item.src.src}
          data-lightbox
          aria-label={item.alt}
        >
          <Image
            src={item.src as any}
            alt={item.alt}
            widths={[360, 640, 900]}
            sizes="(min-width: 900px) 32vw, (min-width: 640px) 46vw, 90vw"
            loading="lazy"
            decoding="async"
          />
          {(item.caption || item.credit) && (
            <div class="article-gallery-caption">
              {item.caption && <span>{item.caption}</span>}
              {item.credit && (
                <span class="article-gallery-credit"> · {item.credit}</span>
              )}
            </div>
          )}
        </a>
      ))}
    </div>
  </figure>
)}

<script>
  /* Lightweight lightbox, no dependencies. Attaches once per page.
   *
   * It opens on a set rather than on a single image: the arrow keys
   * walk the gallery the thumbnail came from, wrapping at both ends,
   * and the same set drives the prev/next controls so a mouse can do
   * what the keyboard can.
   */
  (function () {
    if (typeof document === 'undefined') return;
    if ((window as any).__athLightboxBound) return;
    (window as any).__athLightboxBound = true;

    function openLightbox(links: HTMLAnchorElement[], startIndex: number) {
      let index = startIndex;
      const many = links.length > 1;
      const opener = document.activeElement as HTMLElement | null;

      const overlay = document.createElement('div');
      overlay.className = 'ath-lightbox';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');

      const img = document.createElement('img');

      const close = document.createElement('button');
      close.className = 'ath-lightbox-close';
      close.setAttribute('aria-label', 'Close');
      close.textContent = '\u00d7';

      const prev = document.createElement('button');
      prev.className = 'ath-lightbox-nav ath-lightbox-nav--prev';
      prev.setAttribute('aria-label', 'Previous image');
      prev.textContent = '\u2039';

      const next = document.createElement('button');
      next.className = 'ath-lightbox-nav ath-lightbox-nav--next';
      next.setAttribute('aria-label', 'Next image');
      next.textContent = '\u203a';

      const counter = document.createElement('div');
      counter.className = 'ath-lightbox-counter';

      overlay.append(close, img);
      if (many) overlay.append(prev, next, counter);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';

      /* Text is set as text, never as markup: these captions come from
         frontmatter and have no business being parsed as HTML. */
      function show(i: number) {
        index = (i + links.length) % links.length;   // wraps both ways
        const link = links[index];
        const label = link.getAttribute('aria-label') || '';
        img.src = link.href;
        img.alt = label;
        overlay.setAttribute('aria-label', label);
        counter.textContent = index + 1 + ' / ' + links.length;
      }

      function dismiss() {
        overlay.remove();
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKey);
        if (opener && typeof opener.focus === 'function') opener.focus();
      }

      function onKey(e: KeyboardEvent) {
        if (e.key === 'Escape') { dismiss(); return; }
        if (!many) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      }

      overlay.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === overlay || t === close) dismiss();
      });
      prev.addEventListener('click', () => show(index - 1));
      next.addEventListener('click', () => show(index + 1));
      document.addEventListener('keydown', onKey);

      show(index);
      close.focus();
    }

    document.addEventListener('click', function (e) {
      const target = e.target as HTMLElement;
      const link = target.closest('a[data-lightbox]') as HTMLAnchorElement | null;
      if (!link) return;
      e.preventDefault();
      // The set is the grid this thumbnail belongs to, so two galleries
      // on one page stay separate.
      const grid = link.closest('[data-gallery-grid]');
      const links = grid
        ? (Array.from(grid.querySelectorAll('a[data-lightbox]')) as HTMLAnchorElement[])
        : [link];
      openLightbox(links, Math.max(0, links.indexOf(link)));
    });
  })();
</script>
