---
/**
 * A still that becomes a player when somebody asks for it.
 *
 * Shared by the article hero and the companion callout, so the
 * click-to-load behaviour exists once. Nothing from YouTube is fetched
 * until the click: rendering the embed on every page view would cost
 * every reader the player's weight and its cookies whether they watch
 * or not.
 *
 * The poster is the article's own hero art when there is one — already
 * through the image pipeline, and the picture an editor chose — and
 * YouTube's thumbnail only when there isn't.
 */

import { Image, type ImageMetadata } from 'astro:assets';

interface Props {
  videoId: string;
  /** Used for the button's label and the player's title. */
  label: string;
  /** Article art to use instead of YouTube's thumbnail. */
  poster?: ImageMetadata;
  posterAlt?: string;
  /** Heroes load eagerly; a callout further down the page does not. */
  eager?: boolean;
}

const { videoId, label, poster, posterAlt, eager = false } = Astro.props;
const ytPoster = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<button
  type="button"
  class="video-facade"
  data-video-facade={videoId}
  aria-label={`Play video: ${label}`}
>
  {
    poster ? (
      <Image
        src={poster}
        alt={posterAlt ?? ''}
        widths={[720, 1080, 1440, 1920]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <img
        src={ytPoster}
        data-fallback={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  <span class="video-facade__play" aria-hidden="true"></span>
</button>

<script>
  (function () {
    if (typeof document === 'undefined') return;
    if ((window as any).__athVideoFacadeBound) return;
    (window as any).__athVideoFacadeBound = true;

    // maxresdefault does not exist for every video; fall back quietly.
    document.addEventListener(
      'error',
      (e) => {
        const img = e.target as HTMLImageElement;
        if (!img || img.tagName !== 'IMG') return;
        const fallback = img.getAttribute('data-fallback');
        if (!fallback || img.src === fallback) return;
        img.src = fallback;
      },
      true,
    );

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest(
        '.video-facade',
      ) as HTMLButtonElement | null;
      if (!btn) return;
      const id = btn.getAttribute('data-video-facade');
      if (!id) return;

      const frame = document.createElement('iframe');
      frame.src =
        'https://www.youtube-nocookie.com/embed/' +
        id +
        '?autoplay=1&rel=0&playsinline=1';
      frame.title = btn.getAttribute('aria-label') || 'Video';
      frame.setAttribute(
        'allow',
        'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture',
      );
      frame.setAttribute('allowfullscreen', '');
      frame.className = 'video-facade__player';
      btn.replaceWith(frame);
      frame.focus();
    });
  })();
</script>

<style>
  .video-facade,
  :global(.video-facade__player) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .video-facade {
    position: relative;
    padding: 0;
    background: var(--navy-dark);
    cursor: pointer;
    overflow: hidden;
  }
  .video-facade :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out, opacity 0.2s ease-out;
  }
  .video-facade:hover :global(img) {
    transform: scale(1.02);
    opacity: 0.86;
  }
  /* A rust disc with a triangle cut from borders. */
  .video-facade__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 78px;
    height: 78px;
    margin: -39px 0 0 -39px;
    border-radius: 50%;
    background: var(--rust);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
    transition: background 0.2s ease-out, transform 0.2s ease-out;
  }
  .video-facade__play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    margin: -13px 0 0 -8px;
    border-style: solid;
    border-width: 13px 0 13px 21px;
    border-color: transparent transparent transparent #fff;
  }
  .video-facade:hover .video-facade__play {
    background: var(--rust-light);
    transform: scale(1.05);
  }
  .video-facade:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: -4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-facade :global(img),
    .video-facade__play { transition: none; }
    .video-facade:hover :global(img) { transform: none; }
    .video-facade:hover .video-facade__play { transform: none; }
  }
</style>
