---
/**
 * /signin — one screen, one thing to do.
 *
 * A card over the same film /subscribe opens on, with no masthead and
 * no footer: a reader who came here came to get in, and everything
 * else is a way to leave without doing it. The two commerce screens
 * match each other rather than the landing page.
 *
 * This is a STATIC page, so it cannot branch server-side on ?sent=1 —
 * that would evaluate at build time, not per request. Both states are
 * rendered and a small script picks one at load.
 */

import BareLayout from '../layouts/BareLayout.astro';
import FilmBackdrop from '../components/FilmBackdrop.astro';
import { BAY_AT_LAST_LIGHT } from '../data/films';
---

<BareLayout
  title="Sign in — The Local Lookout"
  description="Sign in to The Local Lookout with a magic link."
  ogImage="/og/default.png"
>
  <FilmBackdrop film={BAY_AT_LAST_LIGHT} />

  <!-- Transparent bar: the mark, and nothing to leave by. -->
  <header class="bar">
    <a href="/" class="boxmark" aria-label="The Local Lookout — home">ATH</a>
  </header>

  <main class="stage">
    <div class="card">
      <!-- After the link is sent -->
      <section data-signin-state="sent" hidden>
        <p class="card__kicker">Check your email</p>
        <h1 class="card__title">The link is on its way.</h1>
        <p class="card__lede">
          It expires in fifteen minutes. Close this tab and open the
          link from your inbox.
        </p>
        <p class="card__foot">
          Didn't arrive? Check your spam folder, or
          <a href="/signin">try again</a>.
        </p>
      </section>

      <!-- Before it is -->
      <section data-signin-state="form">
        <p class="card__kicker">Sign in</p>
        <h1 class="card__title">Sign in with a magic link.</h1>
        <p class="card__lede">
          Type the email you subscribed with. We'll send a one-click
          link — no password, and no newsletter.
        </p>
        <form class="signin" method="POST" action="/api/login-request">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="signin__input"
            aria-label="Email address"
          />
          <button type="submit" class="btn btn--primary">
            Send the link
          </button>
        </form>
        <p class="card__foot">
          Not a subscriber yet? <a href="/subscribe">Subscribe</a>.
        </p>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      if (new URLSearchParams(location.search).get('sent') !== '1') return;
      var sent = document.querySelector('[data-signin-state="sent"]');
      var form = document.querySelector('[data-signin-state="form"]');
      if (!sent || !form) return;
      sent.hidden = false;
      form.hidden = true;
    })();
  </script>
</BareLayout>

<style>
  /* ── Transparent bar: the mark only ───────────────────────────── */
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 22px 28px;
  }
  /* The ATH mark, boxed — the same rectangle the masthead and the
     subscribe page use. */
  .boxmark {
    position: relative;
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-2);
    border: 1px solid var(--on-dark-2);
    padding: 5px 10px 6px;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.18s ease-out, border-color 0.18s ease-out;
  }
  /* The rectangle stays small; the thing a thumb has to hit does not. */
  .boxmark::after {
    content: '';
    position: absolute;
    inset: -9px -8px;
  }
  .boxmark:hover {
    color: var(--on-dark-1);
    border-color: var(--on-dark-1);
  }
  .boxmark:focus-visible {
    outline: 2px solid var(--rust-on-dark);
    outline-offset: 3px;
  }

  /* ── The card, centred on the screen ──────────────────────────── */
  .stage {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 84px 20px 28px;
    box-sizing: border-box;
  }
  .card {
    width: 100%;
    max-width: 440px;
    background: var(--paper);
    border: 1px solid rgba(201, 185, 154, 0.5);
    box-shadow: 0 24px 60px rgba(16, 25, 43, 0.4);
    padding: 30px 30px 22px;
    text-align: center;
    max-height: 100%;
    overflow-y: auto;
    box-sizing: border-box;
  }
  .card__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 10px;
  }
  .card__title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .card__lede {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 20px;
  }
  .card__foot {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--sand-light);
  }
  .card__foot a {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── The form ─────────────────────────────────────────────────── */
  .signin {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .signin__input {
    width: 100%;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid var(--sand);
    color: var(--ink);
    padding: 13px 14px;
    font-family: var(--font-body);
    font-size: 15px;
    text-align: center;
  }
  .signin__input::placeholder {
    color: var(--muted, #6B6158);
  }
  .signin__input:focus {
    outline: 2px solid var(--rust);
    outline-offset: -1px;
  }
  .btn {
    display: block;
    width: 100%;
    padding: 13px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    box-sizing: border-box;
  }
  .btn--primary {
    background: var(--rust);
    color: #fff;
    transition: background 0.15s ease-out;
  }
  .btn--primary:hover {
    background: var(--rust-light);
  }

  @media (max-height: 560px) {
    .card__lede { display: none; }
    .card { padding: 22px 24px 16px; }
    .stage { padding-top: 72px; }
  }
  @media (max-width: 420px) {
    .bar { padding: 16px 18px; }
    .boxmark { font-size: 14px; }
    .card { padding: 24px 22px 18px; }
  }
</style>
