---
/**
 * /subscribe — Subscription page.
 *
 * One plan: Print, $75 a quarter, posting to /api/checkout (handled
 * by the Cloudflare Worker). Single issues are sold on each issue's
 * own page, not here. Sign-in form posts to /api/login-request
 * (magic link via Resend).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Subscribe — The Local Lookout"
  description="Four issues a year, mailed from Highlands, plus the whole archive online. Seventy-five dollars a quarter."
  ogImage="/og/default.png"
>
  <!-- Checkout-cancelled notice (shown when Stripe redirects back with ?cancelled=1) -->
  <div id="checkout-cancelled-banner" hidden style="background: var(--cream-dark); border-bottom: 1px solid var(--sand); padding: 14px 24px; text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft);">
    No charge was made. Pick a plan below whenever you're ready.
    <button onclick="this.parentElement.hidden=true" style="margin-left: 16px; background: none; border: none; cursor: pointer; color: var(--muted); font-size: 14px; line-height: 1;" aria-label="Dismiss">✕</button>
  </div>
  <script>
    if (new URLSearchParams(location.search).get('cancelled') === '1') {
      document.getElementById('checkout-cancelled-banner').hidden = false;
    }
  </script>

  <!-- Hero -->
  <section style="padding: 96px 0 56px;">
    <div class="mag-container-narrow" style="text-align: center;">
      <div class="meta-dotted" style="margin-bottom: 20px; justify-content: center;">
        Subscribe<span class="dot">·</span>One plan, one magazine
      </div>
      <h1
        style="font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 5.2vw, 4rem); letter-spacing: -0.025em; color: var(--ink); line-height: 1.05; margin-bottom: 24px;"
      >
        Four issues a year, <em style="font-weight: 400; color: var(--rust);">and the whole archive.</em>
      </h1>
      <p
        style="font-family: var(--font-display); font-style: italic; font-size: 20px; line-height: 1.55; color: var(--ink-soft); max-width: 620px; margin: 0 auto;"
      >
        The Local Lookout publishes quarterly. One subscription
        covers all of it — four printed issues in the mail, and
        everything we publish online.
      </p>
    </div>
  </section>

  <!-- Signed-in subscriber banner (revealed by JS when /api/me
       reports an active tier). Sits above the tier cards so the
       page reads as "you're in" before they scan the grid. -->
  <section class="subscriber-banner-section" data-mag-subscriber-banner hidden>
    <div class="mag-container-narrow">
      <div class="subscriber-banner">
        <div class="subscriber-banner-copy">
          <span class="subscriber-banner-kicker">You're subscribed</span>
          <strong data-mag-current-tier-label></strong>
        </div>
        <a href="/account" class="subscriber-banner-cta">Manage your plan →</a>
      </div>
    </div>
  </section>

  <!-- Subscription card -->
  <section style="padding: 40px 0 96px;">
    <div class="mag-container-narrow">
      <div class="tier-cards">
        <div class="tier-card tier-card--featured" data-mag-tier-card="print">
          <div class="tier-card-kicker" style="color: var(--rust);">Print</div>
          <div class="tier-card-price">
            $75<span class="tier-card-unit"> / quarter</span>
          </div>
          <div class="tier-card-cadence">Billed quarterly</div>
          <p class="tier-card-desc">
            Four issues delivered by mail. Thick paper, real ink, wide
            margins. Everything we publish online comes with it —
            subscriber features, previews of future issues, and the
            full archive.
          </p>
          <ul class="tier-list">
            <li>Four printed issues a year, mailed from Highlands, NJ</li>
            <li>All features and subscriber essays online</li>
            <li>Previews of future issues</li>
            <li>Audio narration of every story</li>
            <li>Back issues at half price ($50)</li>
            <li>Cancel anytime from your account</li>
          </ul>
          <form method="POST" action="/api/checkout" class="tier-form" data-mag-tier-cta="anon">
            <input type="hidden" name="tier" value="print" />
            <button type="submit" class="tier-cta tier-cta--live">
              Subscribe — $75 / quarter
            </button>
          </form>
          <a href="/account" class="tier-cta tier-cta--current" data-mag-tier-cta="current" hidden>
            ✓ Current plan · Manage
          </a>
          <a href="/account" class="tier-cta tier-cta--switch" data-mag-tier-cta="switch" hidden>
            Upgrade to Print →
          </a>
        </div>
      </div>
      <p class="tier-aside">
        Want just one issue? Every issue in
        <a href="/archive">the archive</a> can be bought on its own
        page — one printed copy, plus digital access to that issue.
      </p>
    </div>
  </section>

  <!-- Sign-in -->
  <section id="signin" style="background: var(--navy); color: var(--on-dark-1); padding: 80px 0;">
    <div class="mag-container-narrow" style="text-align: center;">
      <div
        style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sand-light); margin-bottom: 20px;"
      >
        <span style="color: var(--rust-light);">—</span>&nbsp;&nbsp;Already subscribed
      </div>
      <h2
        style="font-family: var(--font-display); font-size: clamp(1.8rem, 3.4vw, 2.4rem); color: #fff; line-height: 1.15; letter-spacing: -0.02em; font-weight: 700; margin-bottom: 20px;"
      >
        Sign in to read.
      </h2>
      <p
        style="font-family: var(--font-body); font-size: 17px; line-height: 1.65; color: var(--on-dark-3); max-width: 540px; margin: 0 auto 32px;"
      >
        Type your email and we'll send a one-click sign-in link. No
        password to forget, no newsletter to unsubscribe from.
      </p>
      <form class="signin-form" method="POST" action="/api/login-request">
        <input
          type="email"
          name="email"
          required
          placeholder="your@email.com"
          class="signin-input"
          aria-label="Email address"
        />
        <button type="submit" class="signin-button">
          Send sign-in link <span class="arrow">→</span>
        </button>
      </form>
      <p
        style="margin-top: 16px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sand);"
      >
        The link expires in 15 minutes
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding: 96px 0;">
    <div class="mag-container-narrow">
      <div class="meta-dotted" style="margin-bottom: 16px; justify-content: center;">
        Questions we get
      </div>
      <h2
        style="font-family: var(--font-display); font-size: clamp(1.8rem, 3.4vw, 2.4rem); font-weight: 700; letter-spacing: -0.02em; text-align: center; margin-bottom: 48px;"
      >
        A few things to know.
      </h2>

      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-q">Can I cancel?</h3>
          <p class="faq-a">
            Anytime, from your account page. A cancellation takes
            effect at the close of the current quarter — you keep
            access, and receive the issue, for whatever you already
            paid for.
          </p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">What happens to the free version?</h3>
          <p class="faq-a">
            Nothing changes. The editor's letter, one free feature per
            issue, and the archive of past free stories stay free, with
            no account required. The subscription is additive —
            subscriber features, previews, audio, and the printed
            magazine — not a paywall dropping in front of what you
            already read.
          </p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">Does the subscription include online access?</h3>
          <p class="faq-a">
            Yes. There is no separate digital plan — the quarterly
            subscription gets you the mailed magazine and everything
            online, signed in with the same email.
          </p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">Can I buy just one issue?</h3>
          <p class="faq-a">
            Yes, from that issue's own page in
            <a href="/archive">the archive</a>. Pay $100 once and give
            us a shipping address. We mail the printed copy from
            Highlands, and the digital version of that issue unlocks
            for you right away. Subscribers pay $50 for extras.
          </p>
        </div>

        <div class="faq-item">
          <h3 class="faq-q">Who is behind the magazine?</h3>
          <p class="faq-a">
            The Local Lookout is the quarterly print publication of
            Above the Hook, a place-based coastal storytelling brand
            founded in 2025 by Eric Kane and Mary McKiever, based in
            Highlands, New Jersey.
          </p>
        </div>
      </div>

      <div style="text-align: center; margin-top: 56px;">
        <p
          style="font-family: var(--font-body); font-size: 16px; line-height: 1.65; color: var(--ink-soft);"
        >
          Still have a question? Write us at
          <a
            href="mailto:hello@abovethehook.com"
            style="color: var(--rust); text-decoration: underline; text-underline-offset: 3px;"
            >hello@abovethehook.com</a
          >.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      /* Reshape the subscription card to reflect the signed-in
         reader's current plan. Anonymous readers see the default
         Subscribe CTA.

         "digital" is a legacy plan — no longer sold, but existing
         subscribers still hold it, so it is recognised here and
         offered an upgrade to Print. */
      var TIER_LABELS = {
        digital: 'Digital — $10 / mo (legacy)',
        print:   'Print — $75 / quarter',
      };

      fetch('/api/me', { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.signedIn) return;
          var ents = data.entitlements || [];
          var activeTier = null;
          for (var i = 0; i < ents.length; i++) {
            if (ents[i].tier === 'print') { activeTier = 'print'; break; }
            if (ents[i].tier === 'digital') activeTier = 'digital';
          }
          if (!activeTier) return;

          // Reveal the top banner
          var banner = document.querySelector('[data-mag-subscriber-banner]');
          if (banner) {
            banner.removeAttribute('hidden');
            var label = banner.querySelector('[data-mag-current-tier-label]');
            if (label) label.textContent = TIER_LABELS[activeTier] || activeTier;
          }

          var card = document.querySelector('[data-mag-tier-card="print"]');
          if (!card) return;
          if (activeTier === 'print') {
            setCtaState(card, 'current');
            card.classList.add('tier-card--current');
          } else {
            setCtaState(card, 'switch');
          }
        })
        .catch(function () { /* keep defaults on any failure */ });

      function setCtaState(card, state) {
        var ctas = card.querySelectorAll('[data-mag-tier-cta]');
        for (var i = 0; i < ctas.length; i++) {
          if (ctas[i].getAttribute('data-mag-tier-cta') === state) {
            ctas[i].removeAttribute('hidden');
          } else {
            ctas[i].setAttribute('hidden', '');
          }
        }
      }
    })();
  </script>
</BaseLayout>

<style>
  .tier-cards {
    display: grid;
    grid-template-columns: minmax(0, 460px);
    justify-content: center;
  }

  .tier-card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--sand);
    padding: 40px 32px 32px;
    display: flex;
    flex-direction: column;
  }

  .tier-card--featured {
    border: 2px solid var(--rust);
    background: var(--cream-dark, var(--paper));
  }

  /* Note under the card pointing at single-issue purchase */
  .tier-aside {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    text-align: center;
    max-width: 460px;
    margin: 24px auto 0;
  }
  .tier-aside a {
    color: var(--rust);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tier-card-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .tier-card-price {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 4px;
  }

  .tier-card-unit {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 400;
    margin-left: 6px;
  }

  .tier-card-cadence {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .tier-card-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 24px;
  }

  .tier-list {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    border-top: 1px solid var(--sand);
  }
  .tier-list li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    padding: 12px 0;
    border-bottom: 1px solid var(--sand);
  }
  .tier-list li::before {
    content: '·';
    color: var(--rust);
    margin-right: 10px;
    font-weight: 700;
  }

  .tier-form {
    margin-top: auto;
  }

  .tier-cta {
    display: block;
    text-align: center;
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: auto;
    border: 0;
    cursor: pointer;
    width: 100%;
  }

  .tier-cta--live {
    background: var(--rust);
    color: #fff;
    transition: background 0.15s ease-out;
  }
  .tier-cta--live:hover {
    background: var(--rust-light, #C4583E);
  }

  /* Current-plan CTA: solid navy with a checkmark, links to /account */
  .tier-cta--current {
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    border: 0;
  }
  .tier-cta--current:hover {
    background: var(--navy-light, #1C4472);
  }

  /* Switch-plan CTA (upgrade/downgrade): outlined, understated */
  .tier-cta--switch {
    background: transparent;
    color: var(--rust);
    border: 1px solid var(--rust);
    text-decoration: none;
    transition: background 0.15s ease-out, color 0.15s ease-out;
  }
  .tier-cta--switch:hover {
    background: var(--rust);
    color: #fff;
  }

  /* Current-plan card gets a subtle ring so the eye lands on it */
  .tier-card--current {
    border-color: var(--navy);
    border-width: 2px;
  }

  /* Subscriber banner */
  .subscriber-banner-section {
    padding: 16px 0 0;
  }
  .subscriber-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 22px;
    background: var(--cream-dark, #EFE6D2);
    border: 1px solid var(--sand);
  }
  .subscriber-banner-copy {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .subscriber-banner-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .subscriber-banner-copy strong {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .subscriber-banner-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
    text-decoration: none;
    border: 1px solid var(--rust);
    padding: 9px 14px;
    transition: background 0.15s ease-out, color 0.15s ease-out;
  }
  .subscriber-banner-cta:hover {
    background: var(--rust);
    color: #fff;
  }

  /* Sign-in form */
  .signin-form {
    display: flex;
    gap: 12px;
    max-width: 520px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .signin-input {
    flex: 1;
    min-width: 220px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    padding: 14px 16px;
    font-family: var(--font-body);
    font-size: 15px;
  }
  .signin-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  .signin-input:focus {
    outline: 2px solid var(--rust-light, #C4583E);
    outline-offset: -1px;
  }
  .signin-button {
    background: var(--rust);
    color: #fff;
    border: 0;
    padding: 14px 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease-out;
  }
  .signin-button:hover {
    background: var(--rust-light, #C4583E);
  }

  /* FAQ */
  .faq-list {
    display: grid;
    gap: 8px;
  }
  .faq-item {
    padding: 28px 0;
    border-top: 1px solid var(--sand);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--sand);
  }
  .faq-q {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .faq-a {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
    max-width: 640px;
  }

  @media (max-width: 900px) {
    .tier-cards { grid-template-columns: 1fr; }
    .tier-card { padding: 32px 24px 24px; }
  }
</style>
