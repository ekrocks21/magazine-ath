---
/**
 * /subscribe — one screen, one decision.
 *
 * Leads with the issue that is out now, because a thing you can hold
 * is easier to say yes to than a commitment — and puts the choice
 * right under it rather than behind a click. The subscription is
 * already selected: $25 a month is one issue for $25 less than buying
 * it outright, so the option carries its own argument.
 *
 * Both options POST to the Worker's /api/checkout. `tier` comes from
 * the selected radio and `issue` rides along for the single-issue
 * path, where it names the issue being bought.
 *
 * No masthead and no footer: see BareLayout. The film behind it is the
 * same loop the shop opens on, served from the shared R2 bucket.
 */

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BareLayout from '../layouts/BareLayout.astro';
import FilmBackdrop from '../components/FilmBackdrop.astro';
import { BAY_AT_LAST_LIGHT } from '../data/films';

/**
 * Display prices only — Stripe is the source of truth. These must
 * track PRICE_SINGLE_ISSUE and PRICE_PRINT_QUARTERLY in the Worker's
 * wrangler.toml, which is what a reader is actually charged.
 */
const ISSUE_PRICE = '$100';
const SUBSCRIPTION_PRICE = '$25';

// The issue that is out now — most recently published, same rule the
// home page uses so the two can never disagree.
const NOW = Date.now();
const issues = (await getCollection('issues')).sort(
  (a, b) =>
    (b.data.publish_date?.valueOf() ?? 0) - (a.data.publish_date?.valueOf() ?? 0),
);
const current =
  issues.filter((i) => (i.data.publish_date?.valueOf() ?? 0) <= NOW)[0] ??
  issues[0];

const currentSlug = current.id.replace(/\.md$/, '');
const issueNumber = String(current.data.issue_number).padStart(2, '0');
const { title: issueTitle, cover_image, cover_image_alt } = current.data;

---

<BareLayout
  title="Subscribe — The Local Lookout"
  description={`Buy ${issueTitle} on its own, or subscribe for four printed issues a year, mailed from Highlands.`}
  ogImage="/og/default.png"
>
  <FilmBackdrop film={BAY_AT_LAST_LIGHT} />

  <!-- Transparent nav: the mark, and nothing to leave by. -->
  <header class="bar">
    <a href="/" class="mark" aria-label="The Local Lookout — home">
      <span class="mark__sup">Above the Hook · Quarterly</span>
      <span class="mark__main">The Local <em>Lookout</em></span>
    </a>
  </header>

  <main class="stage">
    <div class="card">
      <!-- Cancelled checkout returns here; say so without alarming. -->
      <p class="card__note" data-cancelled hidden>
        No charge was made.
      </p>

      <section>
        {
          cover_image && (
            <Image
              src={cover_image}
              alt={cover_image_alt ?? `${issueTitle} cover`}
              class="card__cover"
              widths={[220, 440]}
              sizes="180px"
              loading="eager"
            />
          )
        }
        <p class="card__kicker">Issue {issueNumber} · Out now</p>
        <h1 class="card__title">{issueTitle}</h1>
        <p class="card__lede">
          The printed magazine, mailed from Highlands. This issue is free
          to read online — subscribing brings the object, and everything
          behind it.
        </p>

        <form method="POST" action="/api/checkout" class="pick">
          <input type="hidden" name="issue" value={currentSlug} />

          <label class="opt">
            <input type="radio" name="tier" value="print" checked />
            <span class="opt__body">
              <span class="opt__head">
                <span class="opt__name">Founding Subscriber</span>
                <span class="opt__price">{SUBSCRIPTION_PRICE}<span class="opt__unit">/month</span></span>
              </span>
              <span class="opt__desc">
                Four printed issues a year, starting with {issueTitle},
                and the run of back issues — at the founding rate, for
                as long as you hold it. Cancel anytime.
              </span>
            </span>
            <span class="opt__flag">Best value</span>
          </label>

          <label class="opt">
            <input type="radio" name="tier" value="single" />
            <span class="opt__body">
              <span class="opt__head">
                <span class="opt__name">Just this issue</span>
                <span class="opt__price">{ISSUE_PRICE}<span class="opt__unit">once</span></span>
              </span>
              <span class="opt__desc">{issueTitle} on its own, mailed to you.</span>
            </span>
          </label>

          <button type="submit" class="btn btn--primary">Continue to payment</button>
        </form>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      'use strict';

      // ── Cancelled-checkout note ────────────────────────────────
      if (new URLSearchParams(location.search).get('cancelled') === '1') {
        var note = document.querySelector('[data-cancelled]');
        if (note) note.hidden = false;
      }

    })();
  </script>
</BareLayout>

<style>
  /* ── Transparent bar: the mark only ───────────────────────────── */
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 22px 28px;
  }
  .mark {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
  }
  .mark__sup {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--on-dark-4);
  }
  .mark__main {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--on-dark-1);
    line-height: 1;
  }
  .mark__main em {
    font-weight: 400;
    font-style: italic;
  }

  /* ── The card, centred on the screen ──────────────────────────── */
  .stage {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 84px 20px 28px;
    box-sizing: border-box;
  }
  .card {
    width: 100%;
    max-width: 404px;
    background: var(--paper);
    border: 1px solid rgba(201, 185, 154, 0.5);
    box-shadow: 0 24px 60px rgba(16, 25, 43, 0.4);
    padding: 24px 26px 14px;
    text-align: center;
    /* If a screen really is too short, the card scrolls rather than
       the page — the film stays put behind it. */
    max-height: 100%;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .card__note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 14px;
  }
  .card__cover {
    display: block;
    width: 148px;
    height: auto;
    margin: 0 auto 18px;
    box-shadow: 0 8px 22px rgba(16, 25, 43, 0.28);
  }
  .card__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 8px;
  }
  .card__title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .card__lede {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 15px;
  }
  /* ── Buttons ──────────────────────────────────────────────────── */
  .btn {
    display: block;
    width: 100%;
    padding: 13px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: 0;
    cursor: pointer;
    box-sizing: border-box;
  }
  .btn--primary {
    background: var(--rust);
    color: #fff;
    transition: background 0.15s ease-out;
  }
  .btn--primary:hover { background: var(--rust-light); }
  .btn--quiet {
    background: transparent;
    color: var(--ink-soft);
    margin-top: 8px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .btn--quiet:hover { color: var(--rust); }

  /* ── The choice ───────────────────────────────────────────────── */
  .pick { margin: 0; }
  .opt {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    text-align: left;
    padding: 13px 14px;
    margin-bottom: 9px;
    border: 1px solid var(--sand);
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease-out, background 0.15s ease-out;
  }
  .opt:hover { border-color: var(--rust-light); }
  .opt:has(input:checked) {
    border-color: var(--rust);
    border-width: 2px;
    padding: 12px 13px;
    background: var(--cream);
  }
  .opt:has(input:focus-visible) {
    outline: 2px solid var(--rust);
    outline-offset: 2px;
  }
  .opt input {
    margin: 2px 0 0;
    accent-color: var(--rust);
    flex: none;
  }
  .opt__body { display: block; flex: 1; min-width: 0; }
  .opt__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .opt__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .opt__price {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }
  .opt__unit {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--muted, #6B6158);
    font-weight: 400;
    margin-left: 3px;
  }
  .opt__desc {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-soft);
    margin-top: 3px;
  }
  .opt__flag {
    position: absolute;
    top: -8px;
    /* Left, not right: the price is right-aligned, and a badge
       directly above it reads as one crowded column. */
    left: 12px;
    background: var(--rust);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 3px 7px;
  }
  .pick .btn--primary { margin-top: 13px; }

  /* ── Short screens: the cover is the first thing to go ─────────── */
  @media (max-height: 720px) {
    .card__cover { width: 104px; margin-bottom: 10px; }
    .card__title { font-size: 25px; margin-bottom: 8px; }
    .card__lede { margin-bottom: 12px; }
    .stage { padding: 72px 20px 20px; }
  }
  @media (max-height: 600px) {
    .card__cover { display: none; }
    .card__lede { margin-bottom: 16px; }
  }
  /* Landscape phone. Everything that is texture rather than
     information comes out, so the choice still fits without the card
     growing its own scrollbar. */
  @media (max-height: 480px) {
    .bar { padding: 10px 18px; }
    .mark__sup { display: none; }
    .mark__main { font-size: 17px; }
    .stage { padding: 46px 16px 12px; }
    .card { padding: 14px 18px 10px; }
    .card__lede { display: none; }
    .card__kicker { margin-bottom: 4px; }
    .card__title { font-size: 21px; margin-bottom: 8px; }
    .opt { padding: 9px 11px; margin-bottom: 6px; }
    .opt:has(input:checked) { padding: 8px 10px; }
    .opt__desc { display: none; }
    .opt__name, .opt__price { font-size: 15px; }
    .btn { padding: 10px 14px; }
    .pick .btn--primary { margin-top: 9px; }
    .btn--quiet { margin-top: 5px; }
  }

  @media (max-width: 420px) {
    .bar { padding: 16px 18px; }
    .mark__main { font-size: 18px; }
    .card { padding: 20px 20px 14px; }
    /* Narrow columns wrap the option copy onto more lines, so the
       cover gives up the room that costs. */
    .card__cover { width: 116px; margin-bottom: 12px; }
    .card__title { font-size: 26px; }
    .stage { padding: 76px 16px 18px; }
  }
</style>
