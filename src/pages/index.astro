---
/**
 * Landing — /
 *
 * Built like the Studios films index: a full-bleed hero, then rails of
 * tiles on a dark ground.
 *
 *   1. Hero — the tall-ships film still, full bleed
 *   2. Issues rail — every issue, next one first, covers in black and
 *      white until you point at them
 *   3. One rail per issue — its articles as image cards
 *
 * The article rails are grouped by issue for now. When the editorial
 * section map arrives (History Corner, Dispatches, and the rest), only
 * `railsFor` below has to change — the markup is already written
 * against "a heading and a list of articles".
 */

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardIllustration from '../components/CardIllustration.astro';
import StructuredData from '../components/StructuredData.astro';
import { articleRoute } from '../utils/article-route';
import { siteWebSite, siteOrganization } from '../utils/structured-data';

/**
 * The hero is a silent loop of the Twin Lights over Highlands, served
 * from R2 as a plain file.
 *
 * It used to be a YouTube embed, which cost an oversized frame to crop
 * the player's own furniture off every edge, a player API to find out
 * when frames were actually moving, and the weight of the player
 * itself. A file needs none of that: the poster is painted on the
 * container, the video covers it when it plays, and if it never plays
 * the poster simply stays.
 */
const FILM = {
  poster: 'https://site-assets.abovethehook.com/magazine/hero.jpg',
  mp4: 'https://site-assets.abovethehook.com/magazine/hero.mp4',
};

/**
 * Provisional section names, read off `type`. Replaced wholesale by the
 * editorial map when it lands — this is the only place a label lives.
 */
const SECTION_LABEL: Record<string, string> = {
  feature: 'Feature',
  essay: 'Essay',
  documentary: 'Documentary',
  interview: 'Interview',
  local_legend: 'Local Legend',
  editors_letter: "Editor's Letter",
  announcement: 'Announcement',
};

const includeDrafts =
  import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' ||
  import.meta.env.DEV === true;

const NOW = Date.now();

// ── Issues, in reading order ──────────────────────────────────────
// The one that is out leads, then back through the archive, and the
// one still to come closes. An issue with no publish_date is
// forthcoming.
const allIssues = await getCollection('issues');
const isForthcoming = (i: CollectionEntry<'issues'>) =>
  (i.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY) > NOW;

const forthcoming = allIssues
  .filter(isForthcoming)
  .sort(
    (a, b) =>
      (a.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY) -
      (b.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY),
  );
const published = allIssues
  .filter((i) => !isForthcoming(i))
  .sort(
    (a, b) =>
      (b.data.publish_date?.valueOf() ?? 0) - (a.data.publish_date?.valueOf() ?? 0),
  );

const orderedIssues = [...published, ...forthcoming];
const forthcomingIds = new Set(forthcoming.map((i) => i.id));

const issueSlug = (i: CollectionEntry<'issues'>) => i.id.replace(/\.md$/, '');

/**
 * "The Summer Issue" — the season, said the way a masthead says it.
 * Cased properly in the text rather than left to text-transform, so
 * what a screen reader announces and what a copy-paste carries match
 * what is on screen.
 */
const issueName = (i: CollectionEntry<'issues'>) => {
  const season = i.data.season;
  return `The ${season.charAt(0).toUpperCase()}${season.slice(1)} Issue`;
};

// ── Articles, grouped into rails ──────────────────────────────────
const allArticles = await getCollection('articles', ({ data }) =>
  includeDrafts ? true : data.status !== 'draft',
);

/** Issue order within a rail: frontmatter `order`, then id. */
function byIssueOrder(a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) {
  const ao = a.data.order ?? Number.POSITIVE_INFINITY;
  const bo = b.data.order ?? Number.POSITIVE_INFINITY;
  return ao !== bo ? ao - bo : a.id.localeCompare(b.id);
}

/** An issue and the pieces that ran in it, in the issue's own order. */
const issueSections = orderedIssues.map((issue) => ({
  issue,
  slug: issueSlug(issue),
  forthcoming: forthcomingIds.has(issue.id),
  articles: allArticles
    .filter((a) => a.data.issue === issueSlug(issue))
    .sort(byIssueOrder),
}));

/** The tag under a tile: section, then the issue it ran in. */
function tagFor(a: CollectionEntry<'articles'>): string {
  const section = SECTION_LABEL[a.data.type] ?? a.data.type;
  const issue = allIssues.find((i) => issueSlug(i) === a.data.issue);
  return issue ? `${section} · ${issue.data.title}` : section;
}
---

<BaseLayout
  title="The Local Lookout — Above the Hook Quarterly"
  description="A quarterly print magazine about the coastal communities of New Jersey. The current issue is free to read online."
  heroFullBleed={true}
>
  <StructuredData data={[siteWebSite(), siteOrganization()]} slot="head" />

  <!-- ── Hero: the film, and nothing over it ──────────────────── -->
  <section class="hero" aria-label="The Twin Lights over Highlands">
    <div
      class="hero__still"
      aria-hidden="true"
      style={`background-image: url(${FILM.poster});`}
    >
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        poster={FILM.poster}
        data-src={FILM.mp4}></video>
    </div>
  </section>

  <!-- ── One section per issue: the card, then what ran in it ── -->
  {
    issueSections.map((sec) => (
      <section class="issue">
        <a class="issuecard" href={`/issues/${sec.slug}`}>
          <span class="issuecard__art">
            {sec.issue.data.cover_image && (
              <Image
                src={sec.issue.data.cover_image}
                alt={sec.issue.data.cover_image_alt ?? `${sec.issue.data.title} cover`}
                widths={[260, 520]}
                sizes="220px"
              />
            )}
          </span>
          <span class="issuecard__body">
            <span class="issuecard__meta">
              {sec.forthcoming
                ? 'Up next'
                : `Issue ${String(sec.issue.data.issue_number).padStart(2, '0')}`}
            </span>
            <span class="issuecard__title">{issueName(sec.issue)}</span>
            {sec.issue.data.theme && (
              <span class="issuecard__theme">{sec.issue.data.theme}</span>
            )}
            <span class="issuecard__go">
              {sec.forthcoming ? 'See what is coming' : 'Read the issue'} →
            </span>
          </span>
        </a>

        {sec.articles.length > 0 && (
          <div class="rail__track">
            {sec.articles.map((a) => (
              <a class="tile" href={articleRoute(a).href}>
                <span class="tile__frame">
                  {a.data.hero_image ? (
                    <Image
                      src={a.data.hero_image}
                      alt={a.data.hero_image_alt ?? a.data.title}
                      class="tile__img"
                      widths={[360, 720]}
                      sizes="300px"
                    />
                  ) : (
                    <CardIllustration
                      slug={articleRoute(a).articleSlug}
                      title={a.data.title}
                    />
                  )}
                </span>
                <span class="tile__foot">
                  <span class="tile__tag">{tagFor(a)}</span>
                  <span class="tile__title">{a.data.title}</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }

  <!-- ── What this is, after you have seen what is in it ───────── -->
  <section class="statement">
    <div class="statement__inner">
      <p class="statement__kicker">Above the Hook · Quarterly</p>
      <h1 class="statement__title">The Local <em>Lookout</em></h1>
      <p class="statement__dek">
        Four issues a year about this stretch of coast — the harbor, the
        history, and the people still living it. The current issue is
        free to read, in full.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      'use strict';

      var video = document.querySelector('.hero__video');
      if (!video) return;

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var conn = navigator.connection || {};

      /* The two refusals a visitor actually asked for: a stated
         preference against motion, and a stated preference against
         spending data. Either one and the file is never fetched — the
         poster is already painted on the container, so the screen is
         the same picture either way. */
      function wanted() {
        return !reduced.matches && !conn.saveData;
      }

      /* Autoplay gets refused even for muted inline video — iOS in Low
         Power Mode is the common case, and that is a real reader. The
         poster is already up, so nothing looks broken; the first real
         gesture is one free second chance, then we stop asking. */
      function play() {
        var p = video.play();
        if (!p || !p.catch) return;
        p.catch(function () {
          var events = ['pointerdown', 'touchstart', 'keydown'];
          var retry = function () {
            events.forEach(function (e) { window.removeEventListener(e, retry); });
            var again = video.play();
            if (again && again.catch) again.catch(function () {});
          };
          events.forEach(function (e) {
            window.addEventListener(e, retry, { once: true, passive: true });
          });
        });
      }

      if (wanted()) {
        // Attached here rather than in the markup, so a visitor who is
        // not being sent motion never downloads it to hide it.
        var source = document.createElement('source');
        source.src = video.getAttribute('data-src');
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
        play();
      }
    })();
  </script>
</BaseLayout>

<style>
  /* The landing runs dark end to end, the way the films index does. */
  :global(body:has(.hero)) {
    background: var(--navy-dark);
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    /* svh, so a phone's collapsing URL bar does not crop the film. */
    height: 100svh;
    min-height: 460px;
    overflow: hidden;
  }
  .hero__still {
    position: absolute;
    inset: 0;
    background-color: var(--navy-dark);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  /* The film covers the poster while it plays. If it never plays —
     no JavaScript, a refused autoplay, a stated preference against
     motion — the poster underneath is already the picture. */
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }

  /* Wash, so cream type holds anywhere on the frame. */
  .hero__still::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom,
        rgba(16, 25, 43, 0.46) 0%,
        rgba(16, 25, 43, 0) 30%,
        rgba(16, 25, 43, 0) 72%,
        rgba(16, 25, 43, 0.55) 100%);
  }

  /* ── One issue, and what ran in it ───────────────────────────── */
  .issue {
    max-width: 1180px;
    margin: 0 auto;
    padding: 60px 0 0;
  }
  .issue:last-of-type {
    padding-bottom: 84px;
  }

  /* The card: the cover, and the issue said large. */
  .issuecard {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 34px;
    align-items: center;
    padding: 0 28px 30px;
    text-decoration: none;
  }
  .issuecard__art {
    display: block;
    /* A real cover's trim, whatever shape the source is — Fall's is a
       landscape placeholder and would otherwise sit short. */
    aspect-ratio: 962 / 1250;
    overflow: hidden;
    background: var(--navy);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
  }
  .issuecard__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out;
  }
  .issuecard:hover .issuecard__art :global(img) {
    transform: scale(1.03);
  }
  .issuecard__body {
    display: block;
  }
  .issuecard__meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--rust-light);
    margin-bottom: 12px;
  }
  .issuecard__title {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.2vw, 3.7rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    line-height: 1.02;
    color: var(--on-dark-1);
    margin-bottom: 14px;
  }
  .issuecard__theme {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.4;
    color: var(--on-dark-3);
    margin-bottom: 18px;
  }
  .issuecard__go {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand);
    transition: color 0.18s ease-out;
  }
  .issuecard:hover .issuecard__go {
    color: var(--on-dark-1);
  }
  .issuecard:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: 4px;
  }

  /* Horizontal shelf of the issue's pieces. Scrolls on its own so a
     long issue never forces the page wide. */
  .rail__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0 28px 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--navy-light) transparent;
    /* Without this the browser snaps the first card's edge to the
       scrollport on load, swallowing the gutter and clipping it
       against the window. */
    scroll-padding-inline: 28px;
  }
  .rail__track > * {
    scroll-snap-align: start;
    flex: none;
  }

  /* ── Article tiles ────────────────────────────────────────────── */
  .tile {
    display: block;
    width: 300px;
    text-decoration: none;
  }
  .tile__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy);
  }
  .tile__frame :global(img),
  .tile__frame :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out;
  }
  .tile:hover .tile__frame :global(img),
  .tile:focus-visible .tile__frame :global(img) {
    transform: scale(1.04);
  }
  .tile__foot {
    display: block;
    padding-top: 12px;
  }
  .tile__tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust-light);
    margin-bottom: 6px;
  }
  .tile__title {
    display: block;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--on-dark-1);
    transition: color 0.2s ease-out;
  }
  .tile:hover .tile__title {
    color: var(--sand-light);
  }
  .tile:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: 4px;
  }

  /* ── The statement, on blue ───────────────────────────────────── */
  .statement {
    background: var(--navy);
    padding: 88px 0 96px;
  }
  .statement__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .statement__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
    margin: 0 0 16px;
  }
  .statement__title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--on-dark-1);
    margin: 0 0 22px;
  }
  .statement__title em {
    font-weight: 400;
    font-style: italic;
  }
  .statement__dek {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.6;
    color: var(--on-dark-3);
    max-width: 560px;
    margin: 0;
  }

  /* An animated zoom is exactly what this setting asks not to see. */
  @media (prefers-reduced-motion: reduce) {
    .tile__frame :global(img),
    .issuecard__art :global(img) {
      transition: none;
    }
    .tile:hover .tile__frame :global(img),
    .issuecard:hover .issuecard__art :global(img) {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .statement { padding: 60px 0 68px; }
    .statement__inner { padding: 0 18px; }
    .tile { width: 260px; }
    .issue { padding-top: 40px; }
    .issuecard {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 0 18px 22px;
    }
    .issuecard__art { width: 150px; }
    .rail__track { padding-left: 18px; padding-right: 18px; scroll-padding-inline: 18px; }
  }
</style>
