---
/**
 * Landing — /
 *
 * Built like the Studios films index: a full-bleed hero, then rails of
 * tiles on a dark ground.
 *
 *   1. Hero — the tall-ships film still, full bleed
 *   2. Issues rail — every issue, next one first, covers in black and
 *      white until you point at them
 *   3. One rail per issue — its articles as image cards
 *
 * The article rails are grouped by issue for now. When the editorial
 * section map arrives (History Corner, Dispatches, and the rest), only
 * `railsFor` below has to change — the markup is already written
 * against "a heading and a list of articles".
 */

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardIllustration from '../components/CardIllustration.astro';
import StructuredData from '../components/StructuredData.astro';
import { articleRoute } from '../utils/article-route';
import { siteWebSite, siteOrganization } from '../utils/structured-data';

/**
 * Hero still — a frame from the same four days the film covers.
 *
 * Not the film's own poster: that image is its title card, with
 * "SAIL4TH 250 / A STORY FROM THE JERSEY SIDE" burned into the
 * artwork, which fights the masthead for the same space. This one is
 * clean, and wide enough to crop hard on a phone.
 *
 * When a video cut of the film lands on R2 this becomes a <video> and
 * this image becomes its poster.
 */
import heroStill from '../content/articles/summer-2026/tall-ship-skyline.jpg';

/**
 * Provisional section names, read off `type`. Replaced wholesale by the
 * editorial map when it lands — this is the only place a label lives.
 */
const SECTION_LABEL: Record<string, string> = {
  feature: 'Feature',
  essay: 'Essay',
  documentary: 'Documentary',
  interview: 'Interview',
  local_legend: 'Local Legend',
  editors_letter: "Editor's Letter",
  announcement: 'Announcement',
};

const includeDrafts =
  import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' ||
  import.meta.env.DEV === true;

const NOW = Date.now();

// ── Issues, in reading order ──────────────────────────────────────
// The one still to come leads, then the most recent, then back through
// the archive. An issue with no publish_date sorts as forthcoming.
const allIssues = await getCollection('issues');
const isForthcoming = (i: CollectionEntry<'issues'>) =>
  (i.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY) > NOW;

const forthcoming = allIssues
  .filter(isForthcoming)
  .sort(
    (a, b) =>
      (a.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY) -
      (b.data.publish_date?.valueOf() ?? Number.POSITIVE_INFINITY),
  );
const published = allIssues
  .filter((i) => !isForthcoming(i))
  .sort(
    (a, b) =>
      (b.data.publish_date?.valueOf() ?? 0) - (a.data.publish_date?.valueOf() ?? 0),
  );

// Next issue first, latest second, then older. Only the leading
// forthcoming issue is billed as next; any beyond it just follow.
const orderedIssues = [...forthcoming, ...published];
const nextIssueId = forthcoming[0]?.id ?? null;
const latestIssueId = published[0]?.id ?? null;

const issueSlug = (i: CollectionEntry<'issues'>) => i.id.replace(/\.md$/, '');

// ── Articles, grouped into rails ──────────────────────────────────
const allArticles = await getCollection('articles', ({ data }) =>
  includeDrafts ? true : data.status !== 'draft',
);

/** Issue order within a rail: frontmatter `order`, then id. */
function byIssueOrder(a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) {
  const ao = a.data.order ?? Number.POSITIVE_INFINITY;
  const bo = b.data.order ?? Number.POSITIVE_INFINITY;
  return ao !== bo ? ao - bo : a.id.localeCompare(b.id);
}

interface Rail {
  key: string;
  heading: string;
  articles: CollectionEntry<'articles'>[];
}

/**
 * One rail per issue, newest first, skipping issues with nothing in
 * them yet. Swap this for a section-based grouping when the map lands.
 */
function railsFor(articles: CollectionEntry<'articles'>[]): Rail[] {
  return published
    .map((issue) => ({
      key: issueSlug(issue),
      heading: issue.data.title,
      articles: articles
        .filter((a) => a.data.issue === issueSlug(issue))
        .sort(byIssueOrder),
    }))
    .filter((rail) => rail.articles.length > 0);
}

const rails = railsFor(allArticles);

/** The tag under a tile: section, then the issue it ran in. */
function tagFor(a: CollectionEntry<'articles'>): string {
  const section = SECTION_LABEL[a.data.type] ?? a.data.type;
  const issue = allIssues.find((i) => issueSlug(i) === a.data.issue);
  return issue ? `${section} · ${issue.data.title}` : section;
}
---

<BaseLayout
  title="The Local Lookout — Above the Hook Quarterly"
  description="A quarterly print magazine about the coastal communities of New Jersey. Every story free to read online."
  heroFullBleed={true}
>
  <StructuredData data={[siteWebSite(), siteOrganization()]} slot="head" />

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__still" aria-hidden="true">
      <Image
        src={heroStill}
        alt=""
        class="hero__img"
        widths={[900, 1400, 2200]}
        sizes="100vw"
        loading="eager"
      />
    </div>
    <div class="hero__inner">
      <p class="hero__kicker">Above the Hook · Quarterly</p>
      <h1 class="hero__title">The Local <em>Lookout</em></h1>
      <p class="hero__dek">
        Four issues a year about this stretch of coast — the harbor, the
        history, and the people still living it. Every story free to read.
      </p>
    </div>
  </section>

  <!-- ── Issues ───────────────────────────────────────────────── -->
  <section class="rail">
    <h2 class="rail__heading">Issues</h2>
    <div class="rail__track">
      {
        orderedIssues.map((issue) => (
          <a class="cover" href={`/issues/${issueSlug(issue)}`}>
            <span class="cover__frame">
              {issue.data.cover_image && (
                <Image
                  src={issue.data.cover_image}
                  alt={issue.data.cover_image_alt ?? `${issue.data.title} cover`}
                  class="cover__img"
                  widths={[240, 480]}
                  sizes="200px"
                />
              )}
              {issue.id === nextIssueId && <span class="cover__flag">Next</span>}
              {issue.id === latestIssueId && <span class="cover__flag">Latest</span>}
            </span>
            <span class="cover__name">{issue.data.title}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ── Articles, a rail per issue ───────────────────────────── -->
  {
    rails.map((rail) => (
      <section class="rail">
        <h2 class="rail__heading">{rail.heading}</h2>
        <div class="rail__track">
          {rail.articles.map((a) => (
            <a class="tile" href={articleRoute(a).href}>
              <span class="tile__frame">
                {a.data.hero_image ? (
                  <Image
                    src={a.data.hero_image}
                    alt={a.data.hero_image_alt ?? a.data.title}
                    class="tile__img"
                    widths={[360, 720]}
                    sizes="300px"
                  />
                ) : (
                  <CardIllustration
                    slug={articleRoute(a).articleSlug}
                    title={a.data.title}
                  />
                )}
              </span>
              <span class="tile__foot">
                <span class="tile__tag">{tagFor(a)}</span>
                <span class="tile__title">{a.data.title}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* The landing runs dark end to end, the way the films index does. */
  :global(body:has(.hero)) {
    background: var(--navy-dark);
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__still {
    position: absolute;
    inset: 0;
    background-color: var(--navy-dark);
  }
  /* :global, because scoped styles do not reach the element <Image>
     renders — the class lands on it, the scope attribute does not. */
  .hero__still :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Wash, so cream type holds anywhere on the frame. */
  .hero__still::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom,
        rgba(16, 25, 43, 0.62) 0%,
        rgba(16, 25, 43, 0.22) 38%,
        rgba(16, 25, 43, 0.92) 100%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px 64px;
  }
  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
    margin: 0 0 14px;
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--on-dark-1);
    margin: 0 0 18px;
  }
  .hero__title em {
    font-weight: 400;
    font-style: italic;
  }
  .hero__dek {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-3);
    max-width: 520px;
    margin: 0;
  }

  /* ── Rails ────────────────────────────────────────────────────── */
  .rail {
    max-width: 1180px;
    margin: 0 auto;
    padding: 44px 0 0;
  }
  .rail:last-of-type {
    padding-bottom: 72px;
  }
  .rail__heading {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--sand);
    margin: 0 0 18px;
    padding: 0 28px;
  }
  /* Horizontal shelf. Scrolls on its own so a long issue never forces
     the page wide. */
  .rail__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0 28px 6px;
    /* Without this the browser snaps the first card's edge to the
       scrollport on load, swallowing the gutter and clipping it
       against the window. Inset the snapport by the same gutter so
       scrollLeft 0 is itself a valid snap position. */
    scroll-padding-inline: 28px;
    scrollbar-width: thin;
    scrollbar-color: var(--navy-light) transparent;
  }
  .rail__track > * {
    scroll-snap-align: start;
    flex: none;
  }

  /* ── Issue covers ─────────────────────────────────────────────── */
  .cover {
    display: block;
    width: 200px;
    text-decoration: none;
  }
  .cover__frame {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--navy);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
    /* Every cover keeps the trim of a real one, whatever shape the
       source is. Fall's placeholder is landscape; without this it sits
       short next to the others and the captions stop lining up. */
    aspect-ratio: 962 / 1250;
  }
  .cover__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Grey until you point at it. */
    filter: grayscale(1) contrast(1.06);
    transition: filter 0.35s ease-out, transform 0.35s ease-out;
  }
  .cover:hover .cover__img,
  .cover:focus-visible .cover__img {
    filter: grayscale(0);
    transform: scale(1.03);
  }
  .cover__flag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--rust);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 4px 8px;
  }
  .cover__name {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-dark-4);
    margin-top: 10px;
    transition: color 0.2s ease-out;
  }
  .cover:hover .cover__name {
    color: var(--on-dark-1);
  }
  .cover:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: 4px;
  }

  /* ── Article tiles ────────────────────────────────────────────── */
  .tile {
    display: block;
    width: 300px;
    text-decoration: none;
  }
  .tile__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy);
  }
  .tile__frame :global(img),
  .tile__frame :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out;
  }
  .tile:hover .tile__frame :global(img),
  .tile:focus-visible .tile__frame :global(img) {
    transform: scale(1.04);
  }
  .tile__foot {
    display: block;
    padding-top: 12px;
  }
  .tile__tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust-light);
    margin-bottom: 6px;
  }
  .tile__title {
    display: block;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--on-dark-1);
    transition: color 0.2s ease-out;
  }
  .tile:hover .tile__title {
    color: var(--sand-light);
  }
  .tile:focus-visible {
    outline: 2px solid var(--rust-light);
    outline-offset: 4px;
  }

  /* An animated zoom is exactly what this setting asks not to see. */
  @media (prefers-reduced-motion: reduce) {
    .cover__img,
    .tile__frame :global(img) {
      transition: none;
    }
    .cover:hover .cover__img,
    .tile:hover .tile__frame :global(img) {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hero { min-height: 62vh; }
    .hero__inner { padding: 0 18px 44px; }
    .rail__heading,
    .rail__track { padding-left: 18px; padding-right: 18px; }
    .rail__track { scroll-padding-inline: 18px; }
    .cover { width: 150px; }
    .tile { width: 260px; }
  }
</style>
